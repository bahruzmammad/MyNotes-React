{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "mynotes-api",
    "main": "src/worker.js",
    "compatibility_date": "2026-09-08",

    "secrets": {
        "required": ["JWT_SECRET"],
    },
    "vars": {
        "NODE_ENV": "production",
        "CLIENT_URL": "https://mynotes-react.pages.dev",
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "mynotes-db",
            "database_id": "c8ea1e5d-ccd8-49c2-a086-b485eb3e92ac",
        },
    ],
    "ratelimits": [
        {
            "name": "API_LIMITER",
            "namespace_id": "1001",
            "simple": {
                "limit": 300,
                "period": 60,
            },
        },
    ],
}
